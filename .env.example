PORT=8787
# Comma-separated list of allowed browser origins for the marketing site
FRONTEND_ORIGIN=http://localhost:3000,https://howethstudio.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_era
ADMIN_API_KEY=replace-with-a-long-random-secret
ADMIN_DASHBOARD_USER=developer
ADMIN_DASHBOARD_PASSWORD=replace-with-a-different-long-random-secret
TRUST_PROXY=1
# Native identity-token audiences. Apple uses the iOS bundle identifier; Google
# uses the Web OAuth client ID configured in the app. Multiple Google audiences
# may be comma-separated.
APPLE_CLIENT_ID=com.footballera.game
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-sign-in-with-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----"
GOOGLE_OAUTH_CLIENT_IDS=replace-with-google-web-client-id.apps.googleusercontent.com
# Long random server secret used to encrypt Apple's refresh token before storage.
AUTH_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Keep true through the account-enabled app rollout, then set false to retire
# anonymous v1 leaderboard reads and writes with HTTP 410.
LEGACY_LEADERBOARDS_ENABLED=true
